# =============================================================================
# Configuracao do Firebase (cliente)
#
# Copie para `.env.local` e preencha com os dados do seu projeto:
#   Firebase Console > Configuracoes do projeto > Seus apps > Configuracao do SDK
#
# Nenhum destes valores e segredo. Sao identificadores publicos que vao no
# bundle do navegador de qualquer aplicacao Firebase. A protecao dos dados esta
# nas Firestore Security Rules (`firestore.rules`), nao no sigilo destas chaves.
#
# Se este arquivo NAO existir, a aplicacao roda em MODO DEMONSTRACAO: sessao
# ficticia no localStorage e dados gerados em memoria. E o caminho padrao para
# clonar o repositorio e navegar no prototipo.
# =============================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Aponta Auth e Firestore para os emuladores locais (firebase emulators:start).
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# true mantem as contas simuladas mesmo quando ha configuracao do Firebase.
# Trocar para false somente depois de implantar e validar o backend de contas.
NEXT_PUBLIC_DEMO_MODE=false

# Para testar sem Firebase: node scripts/create-demo-admin.mjs
# O comando adiciona o verificador local e salva a senha inicial em .local/.

# =============================================================================
# Cobranca da plataforma (Etapa 3)
#
# NAO ha variavel de cobranca aqui, e isso e proposital: `NEXT_PUBLIC_*` vai
# inteira para o bundle do navegador. Chave do gateway e segredo do webhook vao
# para o Secret Manager; o mapa de precos e a URL de retorno vao para o ambiente
# das Cloud Functions:
#
#   STRIPE_SECRET_KEY      (Secret Manager) — so aceita chave sk_test_ nesta etapa
#   STRIPE_WEBHOOK_SECRET  (Secret Manager)
#   STRIPE_PRICE_MAP       JSON {"planId": "price_..."} — o navegador pede plano,
#                          nunca preco
#   APP_BASE_URL           para onde o checkout devolve o assinante
#
# Nos emuladores os valores vem de `scripts/run-access-tests.mjs`, e
# STRIPE_SECRET_KEY fica de fora de proposito: nenhum teste chama o gateway.
# Ver docs/COBRANCA-DA-PLATAFORMA.md, secao 8.
# =============================================================================
