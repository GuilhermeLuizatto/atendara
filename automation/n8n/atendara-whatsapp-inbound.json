      "webhookId": "9d4104c0-1000-4a00-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "const query = $input.first().json.query ?? {};\nconst mode = query['hub.mode'];\nconst token = query['hub.verify_token'];\nconst challenge = query['hub.challenge'];\nconst expected = $env.ATENDARA_META_VERIFY_TOKEN ?? '';\nconst valid = Boolean(expected) && mode === 'subscribe' && token === expected && typeof challenge === 'string' && challenge.length > 0;\nreturn [{ json: { valid, challenge: valid ? challenge : '' } }];"
      },
      "id": "9d4104c0-1000-4a00-8000-000000000002",
      "name": "Conferir token de verificação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-280, -160]
    },
