# Configuração das Functions. Copie para .env.<project-id>; nunca para NEXT_PUBLIC_*.
GEMINI_ENABLED=false
GEMINI_ORGANIZATION_IDS=
# Mude somente após conferir a modalidade paga do projeto Google.
GEMINI_PAID_TIER_CONFIRMED=false
# GEMINI_API_KEY fica no Secret Manager; no emulador, em .secret.local.

# Google Calendar: consulta manual de livre/ocupado (docs/GOOGLE-CALENDAR.md).
GOOGLE_OAUTH_CLIENT_ID=
CALENDAR_REDIRECT_URL=
CALENDAR_KMS_KEY=
# GOOGLE_OAUTH_CLIENT_SECRET e CALENDAR_STATE_SECRET ficam no Secret Manager.

# E-mails transacionais da equipe e do suporte (Amazon SES v2).
SES_REGION=us-east-2
SES_FROM_EMAIL=guilhermeluizatto@gmail.com
SUPPORT_NOTIFICATION_EMAIL=guilhermeluizatto@gmail.com
APP_BASE_URL=https://atendo-a3481.web.app
# SES_ACCESS_KEY_ID e SES_SECRET_ACCESS_KEY ficam no Secret Manager.
