rules_version = '2';

// =============================================================================
// Regras de seguranca do Firestore
//
// Principio: o frontend NUNCA e a barreira. Toda leitura e escrita passa por
// aqui, e o padrao no fim do arquivo e negar tudo o que nao foi explicitamente
// liberado.
//
// Estas regras espelham duas matrizes de `src/config/permissions.ts`:
// `ROLE_PERMISSIONS` (papeis dentro de uma organizacao) e
// `PLATFORM_ROLE_PERMISSIONS` (a operadora, que so alcanca `accounts` e as
// colecoes `platform*`). Nao ha como compartilhar codigo entre TypeScript e
// CEL, entao os dois arquivos precisam ser alterados juntos — o teste
// `src/config/permissions.test.ts` documenta os invariantes que ambos respeitam.
//
// Custo: `isMember()` e `roleOf()` fazem `get()` no documento de membro. Cada
// `get()` conta como uma leitura. Em troca, o isolamento por tenant nao depende
// de nada que o cliente envie. E o trade-off correto.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function accountRef() {
      return /databases/$(database)/documents/accounts/$(uid());
    }

    // Conta existente, liberada e com a senha inicial ja trocada — mas SEM
    // exigir assinatura vigente. E o minimo para alcancar a propria cobranca:
    // quem esta com a mensalidade vencida precisa conseguir ver o plano e a
    // fatura para pagar. Nenhum dado operacional passa por este predicado.
    function signedInAccount() {
      return isSignedIn() && exists(accountRef())
        && get(accountRef()).data.status == 'ACTIVE'
        && get(accountRef()).data.mustChangePassword == false;
    }

    // Acesso operacional: so conta profissional, com validade vigente. A
    // validade vem do webhook ou da concessao registrada, sempre pelo backend.
    // A operadora nao passa por aqui em hipotese nenhuma.
    function activeAccount() {
      return signedInAccount()
        && get(accountRef()).data.platformRole == 'PROFESSIONAL'
        && get(accountRef()).data.subscriptionStatus == 'ACTIVE'
        && get(accountRef()).data.accessUntilMs > request.time.toMillis();
    }

    // A sessao entrou com o segundo fator exigido da operadora. O valor e o id
    // do fator no token; `PLATFORM_ADMIN_SECOND_FACTORS` em
    // `src/config/platform.ts` e o espelho TypeScript. `get` com padrao porque
    // token sem segundo fator nao tem a chave, e chave ausente precisa negar.
    function secondFactor() {
      return request.auth.token.firebase.get('sign_in_second_factor', null) in ['totp'];
    }

    // A operadora. Alcanca `accounts` e as colecoes `platform*` — nunca dado de
    // tenant. Uma sessao sem segundo fator nao e a operadora.
    function platformAdmin() {
      return signedInAccount()
        && get(accountRef()).data.platformRole == 'PLATFORM_ADMIN'
        && secondFactor();
    }

    function moduleAccess(orgId, moduleName) {
      return isMember(orgId) && moduleName in get(accountRef()).data.modules;
    }

    function memberRef(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(uid());
    }

    function isMember(orgId) {
      return activeAccount()
        && get(accountRef()).data.organizationId == orgId
        && get(accountRef()).data.professionId == get(/databases/$(database)/documents/organizations/$(orgId)).data.primaryProfession
        && exists(memberRef(orgId))
        && get(memberRef(orgId)).data.status == 'ACTIVE';
    }

    function roleOf(orgId) {
      return get(memberRef(orgId)).data.role;
    }

    function hasRole(orgId, roles) {
      return isMember(orgId) && roleOf(orgId) in roles;
    }

    // Papeis que podem alterar dados operacionais.
    function canWriteOperational(orgId) {
      return hasRole(orgId, ['OWNER', 'ADMIN', 'PROFESSIONAL', 'ASSISTANT']);
    }

    // Papeis com autonomia sobre a operacao (excluem a secretaria).
    function canManage(orgId) {
      return hasRole(orgId, ['OWNER', 'ADMIN', 'PROFESSIONAL']);
    }

    function isAdmin(orgId) {
      return hasRole(orgId, ['OWNER', 'ADMIN']);
    }

    // Quem responde pela ASSINATURA DA PLATAFORMA daquela organizacao.
    //
    // Nao basta o papel 'OWNER': o profissional autonomo cadastrado por
    // `registerProfessional` nasce como membro 'PROFESSIONAL' e ao mesmo tempo
    // como `ownerId` da propria organizacao. Quem paga a mensalidade e o dono
    // da organizacao, entao e o `ownerId` que manda — o papel entra para o caso
    // da clinica que promove alguem a OWNER.
    //
    // Usa `signedInAccount()` e nao `isMember()` de proposito: com a
    // mensalidade vencida o acesso operacional fecha, e e exatamente nesse
    // momento que a pessoa precisa abrir a propria cobranca para regularizar.
    //
    // O papel so vale com o vinculo ATIVO: sem isso, um OWNER suspenso da
    // organizacao continuaria lendo faturas dela. A callable confere o mesmo.
    function subscriptionOwner(orgId) {
      return platformAdmin() || (signedInAccount()
        && get(accountRef()).data.organizationId == orgId
        && (get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == uid()
          || (exists(memberRef(orgId))
            && get(memberRef(orgId)).data.role == 'OWNER'
            && get(memberRef(orgId)).data.status == 'ACTIVE')));
    }

    // O titular da organizacao (`ownerId`), qualquer que seja o papel dele.
    // Espelha `ORGANIZATION_HOLDER_PERMISSIONS` de `src/config/permissions.ts`.
    // Exige `isMember()`: ser `ownerId` sem vinculo ativo, painel aberto e a
    // propria organizacao na conta nao vale nada.
    function organizationHolder(orgId) {
      return isMember(orgId)
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.ownerId == uid();
    }

    // Quem atende pedido de titular de dados (exportar, eliminar) e le o
    // registro desses pedidos. Espelha `privacy:export`/`privacy:erase` de
    // `src/config/permissions.ts` e `PRIVACY_RESPONSIBLE_ROLES`, mais o titular,
    // pelo mesmo motivo de `subscriptionOwner`: o autonomo nasce PROFESSIONAL e
    // dono.
    function privacyResponsible(orgId) {
      return isAdmin(orgId) || organizationHolder(orgId);
    }

    // A escrita troca somente a configuracao de avisos e o horario de
    // atendimento. E o unico alcance que o titular sem papel administrativo tem
    // sobre o documento da organizacao: nome, dono, agente e privacidade
    // continuam de OWNER/ADMIN. `get` com padrao porque a organizacao nasce sem
    // `settings`, e cada bloco alterado precisa continuar sendo mapa.
    function onlyHolderSettings() {
      let after = request.resource.data.get('settings', {});
      let changed = after.diff(resource.data.get('settings', {})).affectedKeys();
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['settings', 'updatedAt', 'updatedBy'])
        && changed.hasOnly(['notifications', 'agenda'])
        && (!('notifications' in changed) || after.notifications is map)
        && (!('agenda' in changed) || after.agenda is map);
    }

    // Defesa em profundidade: o documento carrega o proprio organizationId e
    // ele precisa bater com o caminho. Impede que um documento de um tenant
    // seja gravado dentro de outro por engano ou por manipulacao do cliente.
    function belongsToOrg(orgId) {
      return request.resource.data.organizationId == orgId;
    }

    // Verifica que a escrita altera apenas os campos permitidos.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(fields);
    }

    // ------------------------------------------ consentimento dos avisos
    //
    // Espelho de `isAllowedConsentTransition`
    // (`src/lib/notifications/consent-record.ts`). O consentimento e prova: por
    // canal, do registro mais antigo ao atual, com data, versao do texto, quem
    // registrou, meio e, para menor de idade, o responsavel legal.
    //
    // Quem registra ja vem da regra de `clients`: `canWriteOperational()` e ali
    // o espelho de `notificationConsent:record`, que `permissions.test.ts`
    // mantem igual a `client:update`.
    //
    // Custo: cada requisicao avalia no maximo 1000 expressoes, e chamada de
    // funcao e recalculada a cada uso (argumento e `let`, uma vez so). Por isso
    // o papel nao e chamado de novo aqui. Medido no emulador em 12/09/2026.
    //
    // Fatia com fim zero (`lista[0:0]`) da erro de indice em vez de lista
    // vazia; toda fatia abaixo e protegida por `?:`. Tipo nao e conferido com
    // `is`: operacao sobre tipo errado e erro, e erro nega.

    // O navegador so registra em nome de quem esta nele. "A propria pessoa
    // registrou" (`SUBJECT`) e afirmacao do backend, nunca do cliente.
    function consentActOk(act) {
      return act.keys().toSet() == ['at', 'medium', 'recordedBy'].toSet()
        && act.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{3})?Z$')
        && act.medium in ['FORM', 'WRITTEN_DOCUMENT', 'MESSAGE']
        && act.recordedBy == {'kind': 'STAFF', 'userId': request.auth.uid};
    }

    function consentGuardianOk(guardian) {
      return guardian.keys().toSet() == ['fullName', 'relationship'].toSet()
        && guardian.fullName.trim().size() >= 3
        && guardian.relationship in ['PARENT', 'LEGAL_GUARDIAN'];
    }

    // Nasce vigente. A versao do texto e identificador fechado, nao frase: vai
    // para a trilha, que nunca e pseudonimizada nesse campo. Menor de idade
    // autoriza pelo responsavel legal, obrigatorio; adulto nao carrega um.
    function newConsentRecordOk(record) {
      return record.keys().toSet() == ['granted', 'legalGuardian', 'subjectIsMinor', 'textVersion', 'withdrawn'].toSet()
        && record.withdrawn == null
        && record.textVersion.matches('^[0-9A-Za-z._-]{1,64}$')
        && consentActOk(record.granted)
        && (record.subjectIsMinor == false
          ? record.legalGuardian == null
          : (record.subjectIsMinor == true ? consentGuardianOk(record.legalGuardian) : false));
    }

    // Acrescentar: o que havia fica igual, o ultimo registro anterior ja estava
    // retirado, e o novo e valido.
    function consentGrantOk(before, after, kept) {
      return (kept == 0 ? true : (after[0:kept] == before && before[kept - 1].withdrawn != null))
        ? newConsentRecordOk(after[kept])
        : false;
    }

    // Retirar: so o registro vigente muda, e so no campo `withdrawn`.
    function consentWithdrawOk(before, after, last) {
      return (before[last].withdrawn == null
          && (last == 0 ? true : after[0:last] == before[0:last])
          && after[last].diff(before[last]).affectedKeys().hasOnly(['withdrawn']))
        ? consentActOk(after[last].withdrawn)
        : false;
    }

    // Historico de UM canal. Uma escrita faz no maximo uma coisa por canal:
    // nada, acrescentar um registro ou retirar o vigente. Nada sai da lista —
    // retirar um canal nao apaga o historico dele.
    function consentHistoryOk(before, after) {
      return after == before
        ? true
        : (after.size() == before.size() + 1
          ? consentGrantOk(before, after, before.size())
          : ((after.size() == before.size() && before.size() > 0)
            ? consentWithdrawOk(before, after, before.size() - 1)
            : false));
    }

    // O formato antigo (uma data so, sem autor) nao nasce mais pelo navegador.
    // Ao passar para o registro por canal, ele fica inteiro em `legacy`.
    function consentOk(before, after) {
      let recordFormat = before != null ? (before.get('formatVersion', 0) == 2) : false;
      let old = recordFormat ? before.channels : {};
      return (after.keys().toSet() == ['channels', 'formatVersion', 'legacy'].toSet()
          && after.formatVersion == 2
          && after.legacy == (recordFormat ? before.get('legacy', null) : before)
          && after.channels.keys().hasOnly(['EMAIL', 'SMS', 'WHATSAPP']))
        ? (consentHistoryOk(old.get('EMAIL', []), after.channels.get('EMAIL', []))
          && consentHistoryOk(old.get('SMS', []), after.channels.get('SMS', []))
          && consentHistoryOk(old.get('WHATSAPP', []), after.channels.get('WHATSAPP', [])))
        : false;
    }

    // Sem mudanca no consentimento, nada a conferir.
    function consentWriteOk(before) {
      let after = request.resource.data.get('notificationConsent', null);
      return after == before ? true : consentOk(before, after);
    }

    // ------------------------------------------------- indice de organizacoes

    // Responde "de quais organizacoes este usuario participa?" sem exigir uma
    // collectionGroup query. Cada usuario le e escreve apenas o proprio doc.
    // Na Fase 2 a manutencao deste documento passa para uma Cloud Function.
    match /userMemberships/{userId} {
      allow read: if isSignedIn() && uid() == userId;
      allow write: if false;
    }

    // Somente o backend confiavel cria papeis, validade e permissoes.
    //
    // A propria conta e legivel sem segundo fator: e o que a tela usa para
    // saber que a operadora precisa cadastrar ou usar o TOTP.
    match /accounts/{userId} {
      allow get: if isSignedIn() && (uid() == userId || platformAdmin());
      allow list: if platformAdmin();
      allow write: if false;
    }
    match /initialPasswords/{userId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------ organizacao

    match /organizations/{orgId} {
      allow read: if isMember(orgId);

      // Organizacao e vinculo nascem no backend, junto da conta do titular.
      allow create: if false;

      // O proprietario nao pode ser trocado por update — isso exigiria um
      // fluxo de transferencia explicito, fora do alcance do cliente.
      //
      // O titular sem papel administrativo configura os proprios avisos e o
      // proprio horario (`notificationSettings:update`, `agendaSettings:update`)
      // e mais nada.
      allow update: if request.resource.data.ownerId == resource.data.ownerId
        && (isAdmin(orgId)
          || (organizationHolder(orgId) && onlyHolderSettings()));

      // Apagar o documento da organizacao pelo navegador trancaria o tenant e
      // deixaria as subcolecoes orfas. Exclusao e ato do backend.
      allow delete: if false;

      // ------------------------------------------------------------- membros

      match /members/{memberId} {
        allow read: if isMember(orgId);
        // Vinculo e papel sao escritos pelo SDK administrativo.
        allow write: if false;
      }

      // ------------------------------------------------------- profissionais

      match /professionals/{professionalId} {
        allow read: if isMember(orgId);
        allow create, update: if isAdmin(orgId) && belongsToOrg(orgId);
        allow delete: if isAdmin(orgId);
      }

      // ------------------------------------------------------------ clientes

      match /clients/{clientId} {
        allow read: if moduleAccess(orgId, 'clientes');
        // O consentimento de aviso so ganha ou retira registro (`consentWriteOk`),
        // e `canWriteOperational()` responde tambem por `notificationConsent:record`.
        // Uma instrucao so para criar e alterar: o motor avalia cada instrucao
        // que casa com a escrita, e duas refariam a cadeia de vinculo.
        // Excluir o cadastro inteiro continua sendo `client:delete`, e a
        // eliminacao a pedido do titular e ato do backend.
        allow create, update: if moduleAccess(orgId, 'clientes') && canWriteOperational(orgId) && belongsToOrg(orgId)
          && consentWriteOk(resource == null ? null : resource.data.get('notificationConsent', null));
        allow delete: if moduleAccess(orgId, 'clientes') && canManage(orgId);
      }

      // -------------------------------------------------------- atendimentos

      match /appointments/{appointmentId} {
        allow read: if moduleAccess(orgId, 'agenda');
        allow create, update: if moduleAccess(orgId, 'agenda') && canWriteOperational(orgId) && belongsToOrg(orgId);
        // Atendimento nao e apagado: e cancelado via update, preservando o
        // historico para o financeiro e para a auditoria.
        allow delete: if false;
      }

      // ------------------------------------------------------------ conversas

      match /conversations/{conversationId} {
        allow read: if moduleAccess(orgId, 'mensagens');
        allow create, update: if moduleAccess(orgId, 'mensagens') && canWriteOperational(orgId) && belongsToOrg(orgId);
        allow delete: if false;

        // Mensagens sao imutaveis: registrar o que foi dito e o que permite
        // auditar as decisoes do agente depois.
        match /messages/{messageId} {
          allow read: if moduleAccess(orgId, 'mensagens');
          allow create: if moduleAccess(orgId, 'mensagens') && canWriteOperational(orgId) && belongsToOrg(orgId);
          allow update, delete: if false;
        }
      }

      // ----------------------------------------------------------- financeiro

      match /transactions/{transactionId} {
        allow read: if moduleAccess(orgId, 'financeiro');
        allow create: if moduleAccess(orgId, 'financeiro') && canWriteOperational(orgId) && belongsToOrg(orgId);
        allow update: if moduleAccess(orgId, 'financeiro') && canManage(orgId) && belongsToOrg(orgId);
        // transaction:delete acompanha ADMIN/OWNER na matriz TypeScript.
        allow delete: if moduleAccess(orgId, 'financeiro') && isAdmin(orgId);
      }

      // ------------------------------------------------- regras do agente IA

      match /aiRules/{ruleId} {
        allow read: if moduleAccess(orgId, 'agente');

        // Regras fundamentais e da profissao nunca sao criadas pelo cliente:
        // vem da semente do sistema. E nada pode nascer ja imutavel por aqui.
        allow create: if moduleAccess(orgId, 'agente') && canManage(orgId)
          && belongsToOrg(orgId)
          && request.resource.data.immutable == false
          && !(request.resource.data.level in ['SECURITY', 'SYSTEM', 'PROFESSION']);

        // Uma regra imutavel nao pode ser editada nem desativada, por ninguem —
        // inclusive OWNER. E isso que torna "Nivel 1" uma garantia e nao uma
        // convencao da interface.
        allow update: if moduleAccess(orgId, 'agente') && canManage(orgId)
          && belongsToOrg(orgId)
          && resource.data.immutable == false
          && request.resource.data.immutable == false
          && request.resource.data.level == resource.data.level;

        allow delete: if moduleAccess(orgId, 'agente') && canManage(orgId) && resource.data.immutable == false;
      }

      // ------------------------------------------- decisoes do agente (audit)

      match /aiDecisions/{decisionId} {
        allow read: if moduleAccess(orgId, 'agente');
        allow create: if moduleAccess(orgId, 'agente') && belongsToOrg(orgId);
        // Registro imutavel. Se pudesse ser alterado, nao seria auditoria. A
        // pseudonimizacao a pedido do titular e do backend, restrita aos campos
        // de `src/config/privacy.ts`; pelo cliente, nada muda.
        allow update, delete: if false;
      }

      // -------------------------------------------------------- notificacoes

      match /notifications/{notificationId} {
        allow read: if isMember(orgId);
        allow create: if isMember(orgId) && belongsToOrg(orgId);
        // O usuario apenas marca como lida/reconhecida; nao reescreve o alerta.
        allow update: if canWriteOperational(orgId)
          && onlyChanges(['status', 'acknowledgedBy', 'acknowledgedAt', 'updatedAt', 'updatedBy']);
        allow delete: if false;
      }

      // ------------------------------------------- avisos ao cliente

      // Fila de saida dos avisos que a organizacao envia a quem ela atende.
      //
      // Nao confundir com `notifications` acima: aquela e o alerta dentro do
      // painel, esta e a mensagem que sai. Por isso o modulo exigido para ler e
      // a `agenda` — todo evento que a alimenta vem de la.
      //
      // Ninguem escreve pelo cliente, em papel nenhum (S-05, Fase 3, 13.2).
      // Planejar e disparar sao atos do backend: o gatilho da agenda planeja, a
      // Cloud Tasks agenda o horario e o despachante envia depois de conferir as
      // travas de novo. Se o navegador escrevesse aqui, um membro marcaria como
      // enviado o que nunca saiu, ou zeraria tentativas e reenviaria sem limite.
      match /notificationDeliveries/{deliveryId} {
        allow read: if moduleAccess(orgId, 'agenda');
        allow write: if false;
      }

      // ------------------------------------------- fila de automacao

      // Cada execucao da automacao — aviso, alerta, registro na trilha —, com
      // estado, tentativa e validade. Mecanismo do backend: ninguem le nem
      // escreve pelo cliente. O painel da fila abre a leitura junto de uma
      // permissao em `src/config/permissions.ts`, quando existir.
      match /automationTasks/{taskId} {
        allow read, write: if false;
      }

      // ------------------------------------------------ trilha de auditoria

      match /auditLogs/{logId} {
        // Somente administracao da propria organizacao le a trilha completa.
        allow read: if isAdmin(orgId);
        allow create: if isMember(orgId) && belongsToOrg(orgId);
        // Append-only, sem excecao de papel. Como em `aiDecisions`, so o
        // backend pseudonimiza, e nunca apaga.
        allow update, delete: if false;
      }

      // ------------------------------------ pedidos de titulares de dados

      // Registro de cada exportacao e eliminacao atendida. Gravado pelo backend
      // no mesmo ato; ninguem escreve pelo cliente, nem quem responde pela
      // organizacao. A operadora nao le: e dado do tenant.
      match /privacyRequests/{requestId} {
        allow read: if privacyResponsible(orgId);
        allow write: if false;
      }
    }

    // ------------------------------------------ mensagens por collectionGroup

    // A caixa de entrada carrega as mensagens de todas as conversas em UMA
    // consulta; um listener por conversa nao escala. Uma `collectionGroup` nao
    // e coberta pela regra aninhada acima, entao precisa desta.
    //
    // Isto NAO afrouxa o isolamento. A consulta obrigatoriamente filtra por
    // `organizationId` (ver `snapshotQueries.messages`): sem esse filtro o
    // Firestore nao consegue provar que todo documento retornado satisfaz a
    // condicao e recusa a consulta inteira — nao devolve um subconjunto. O
    // campo repetido dentro do documento e o que torna a prova possivel.
    //
    // Regras se somam: este bloco acrescenta APENAS leitura. A escrita de
    // mensagem continua sendo decidida pela regra aninhada da conversa, que ja
    // aceita somente `create`.
    match /{path=**}/messages/{messageId} {
      allow read: if moduleAccess(resource.data.organizationId, 'mensagens');
    }

    // ------------------------------------------- cobranca DA PLATAFORMA
    //
    // Estas colecoes sao da operadora (Three Devs), nao de tenant nenhum — por
    // isso vivem na raiz. Elas nao se misturam com
    // `organizations/{orgId}/transactions`, que continua sendo o financeiro do
    // negocio do assinante, com as regras de sempre.
    //
    // NENHUMA delas aceita escrita do cliente, em nenhum papel. Ativar uma
    // assinatura, estender validade ou lancar uma fatura sao consequencias de
    // um evento assinado pelo gateway, ou de uma concessao registrada, aplicadas
    // pelo backend. Voltar da tela de pagamento nao prova pagamento; por isso
    // nao existe caminho do navegador ate estes documentos que nao seja leitura.

    // Catalogo de planos: legivel por qualquer conta liberada, inclusive a que
    // esta com a mensalidade vencida — e ela quem mais precisa ver o catalogo.
    match /platformPlans/{planId} {
      allow read: if signedInAccount();
      allow write: if false;
    }

    // Uma assinatura por organizacao, com o id do documento igual ao
    // organizationId. O assinante le a propria; a operadora le todas.
    match /platformSubscriptions/{orgId} {
      allow read: if subscriptionOwner(orgId);
      allow write: if false;
    }

    // Faturas: o assinante so alcanca as da propria organizacao. Como no
    // collectionGroup de mensagens, a consulta do cliente precisa filtrar por
    // `organizationId` — sem o filtro o Firestore nao consegue provar que todo
    // documento retornado passa na regra e recusa a consulta inteira.
    match /platformInvoices/{invoiceId} {
      allow read: if subscriptionOwner(resource.data.organizationId);
      allow write: if false;
    }

    // Trilha dos eventos do gateway. E o que garante idempotencia, entao e
    // auditoria: so a operadora le, e ninguem escreve pelo cliente.
    match /platformGatewayEvents/{eventId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    // Indice `customerId do gateway -> organizacao`. E o que amarra assinante,
    // organizacao e assinatura; se o cliente pudesse le-lo ou escreve-lo,
    // poderia apontar a cobranca de um para o beneficio de outro.
    match /platformCustomers/{customerId} {
      allow read, write: if false;
    }

    // Concessao manual vigente, uma por organizacao. O titular ve que o acesso
    // dele foi concedido e ate quando; a operadora ve todas. Conceder e revogar
    // so pelas callables, com segundo fator e registro na mesma transacao.
    match /platformAccessGrants/{orgId} {
      allow read: if subscriptionOwner(orgId);
      allow write: if false;
    }

    // Trilha append-only dos atos da operadora. Nem a operadora escreve pelo
    // cliente: uma trilha que o autor edita nao prova nada.
    match /platformAuditLogs/{logId} {
      allow read: if platformAdmin();
      allow write: if false;
    }

    // Contadores de abuso por usuario. Mecanismo interno do backend.
    match /platformRateLimits/{key} {
      allow read, write: if false;
    }

    // ----------------------------------------------------------------- padrao

    // Tudo o que nao foi liberado acima e negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
