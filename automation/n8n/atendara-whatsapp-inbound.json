      },
      "id": "9d4104c0-1000-4a00-8000-000000000006",
      "name": "Evento recebido da Meta",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-520, 200],
      "webhookId": "9d4104c0-1000-4a00-8000-000000000006"
    },
    {
      "parameters": {
        "jsCode": "const { createHmac } = require('crypto');\nconst item = $input.first();\nconst encoded = item.binary?.data?.data;\nif (typeof encoded !== 'string') throw new Error('RAW_BODY_UNAVAILABLE');\nconst rawBody = Buffer.from(encoded, 'base64').toString('utf8');\nconst headers = item.json.headers ?? {};\nconst metaSignature = headers['x-hub-signature-256'] ?? headers['X-Hub-Signature-256'] ?? '';\nif (!/^sha256=[a-f0-9]{64}$/i.test(String(metaSignature))) throw new Error('META_SIGNATURE_HEADER_MISSING');\nconst timestamp = new Date().toISOString();\nconst secret = $env.ATENDARA_CALLBACK_SECRET ?? '';\nconst url = $env.ATENDARA_INBOUND_CALLBACK_URL ?? '';\nif (!secret || !url) throw new Error('INBOUND_BRIDGE_NOT_CONFIGURED');\nconst bridgeSignature = createHmac('sha256', secret).update(`${timestamp}.${rawBody}`).digest('hex');\nreturn [{ json: { rawBody, metaSignature, timestamp, bridgeSignature, url } }];"
      },
      "id": "9d4104c0-1000-4a00-8000-000000000007",
      "name": "Preservar corpo e assinar repasse",
