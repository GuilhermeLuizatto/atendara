# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...mas o modelo precisa ser versionado.
!.env.example

# firebase
.firebase/
.firebaserc
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
*-firebase-adminsdk-*.json
serviceAccountKey.json
firebase-admin-initial-access.txt
admin-initial-access.txt
.local/
.claude/
functions/node_modules/
functions/lib/

# credenciais em geral
# Defesa em profundidade: `.local/` ja cobre os arquivos que geramos hoje, mas
# uma credencial salva por engano fora dela nao pode virar commit.
*.key
*.p12
*.pfx
*.jks
*-adc-*.json
.firebase-cli-adc-*.json
*.credentials.json
gha-creds-*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentos privados de planejamento e execucao
# Relatorios, continuacao, roadmap, revisoes e ADRs ficam so no disco. Vao ao
# repositorio apenas os documentos tecnicos de referencia.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/FIRESTORE-DATA-MODEL.md
/scripts/render-report.mjs
